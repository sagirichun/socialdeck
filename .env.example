# SocialDeck runtime configuration. Copy to .env and fill in per deployment.

# --- core ---
# 32+ random bytes. Rotating this invalidates every stored token and session.
APP_SECRET=
# Absolute origin this deployment is reachable at. Platforms fetch media from it, so it
# must be public when OUTBOUND_MODE=live.
APP_URL=http://127.0.0.1:3000
# sandbox simulates every outbound platform write; live performs real API calls.
OUTBOUND_MODE=sandbox
DB_PATH=
DATA_DIR=
MEDIA_DIR=
FFMPEG_PATH=ffmpeg
SESSION_TTL_HOURS=168

# --- queue ---
# Leave empty to run the in-process timer wheel instead of BullMQ.
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRED=0

# --- ai ---
# Configure providers in the console (AI screen); keys are encrypted at rest there.
# Optional defaults used when a provider row leaves them blank:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=

# --- oauth applications (per platform, configured in the console) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# --- ingress ---
# Shared secret each platform signs webhook payloads with (set per platform in the console).
WEBHOOK_SECRET=
